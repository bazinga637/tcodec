"fn generate_items(amount) {
  let mut items = []

  for i in range(0, amount) {
    let mut value = randint(1, amount)
    
    while value.is_in(items) {
      value = randint(1, amount)
    }
    items.append(value)
  }
  items
}

fn visualize(items) {
  let esc = chr(27)
  let n = len(items)
  let height = n / 2
  let mut rows = []

  for lineidx in range(0, height) {
    let mut row = \"\"
    let threshold = (height - lineidx) * 2

    for item in items {
      if item >= threshold {
        row = row + '#'

      } else if item == threshold - 1 {
        row = row + '.'

      } else {
        row = row + ' '
      }
    }
    rows.append(row)
  }
  print(esc + \"[H\" + rows.join(\"\
\"))
}

fn main() {

  print(\"type 1 for bubble sort\
type 2 for selection sort\
type 3 for insertion sort\
type 4 for cocktail sort\
type 5 for quick sort\")

  let response = readline()

  let mut items = generate_items(80)

  match response {
    '1' => {
      for pass in range(0, len(items)) {
        for i in range(0, len(items) - 1) {
          items = bubble_sort(items)
        }
      }
    }
    '2' => { items = selection_sort(items) }
    '3' => { items = insertion_sort(items) }
    '4' => { items = cocktail_sort(items) }
    '5' => { items = quick_sort(items, 0, len(items) - 1) }
  }
}

fn bubble_sort(mut items) {
  let n = len(items)

  for pass in range(0, n) {
    let mut swapped = false

    for i in range(0, n - 1 - pass) {
      if items[i] > items[i + 1] {
        let item = items[i + 1]
        items[i + 1] = items[i]
        items[i] = item
        swapped = true
        visualize(items)
      }
    }

    if !swapped {
      return items
    }
  }
  items
}

fn selection_sort(mut items) {
  let n = len(items)

  for i in range(0, n) {
    let mut min_idx = i

    for j in range(i + 1, n) {
      if items[j] < items[min_idx] {
        min_idx = j
      }
    }

    if min_idx != i {
      let temp = items[i]
      items[i] = items[min_idx]
      items[min_idx] = temp
      visualize(items)
    }
  }
  items
}

fn insertion_sort(mut items) {
  let n = len(items)

  for i in range(1, n) {
    let key = items[i]
    let mut j = i - 1

    while j >= 0 && items[j] > key {
      items[j + 1] = items[j]
      j = j - 1
      visualize(items)
    }

    items[j + 1] = key
    visualize(items)
  }
  items
}

fn cocktail_sort(mut items) {
  let mut swapped = true
  let mut start = 0
  let mut end = len(items) - 1

  while swapped {
    swapped = false

    for i in range(start, end) {
      if items[i] > items[i + 1] {
        let temp = items[i]
        items[i] = items[i + 1]
        items[i + 1] = temp
        swapped = true
        visualize(items)
      }
    }

    if !swapped {
      return items
    }

    swapped = false
    end = end - 1

    let mut j = end - 1
    while j >= start {
      if items[j] > items[j + 1] {
        let temp = items[j]
        items[j] = items[j + 1]
        items[j + 1] = temp
        swapped = true
        visualize(items)
      }
      j = j - 1
    }

    start = start + 1
  }
  items
}

fn quick_sort(mut items, low, high) {
  if low < high {
    let pivot = items[high]
    let mut i = low - 1

    for j in range(low, high) {
      if items[j] <= pivot {
        i = i + 1
        let temp = items[i]
        items[i] = items[j]
        items[j] = temp
        visualize(items)
      }
    }

    let temp = items[i + 1]
    items[i + 1] = items[high]
    items[high] = temp
    visualize(items)

    let pi = i + 1
    items = quick_sort(items, low, pi - 1)
    items = quick_sort(items, pi + 1, high)
  }
  items
}
